# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── OpenPages instance ────────────────────────────────────────────────────────
OPENPAGES_BASE_URL=http://<host>:<port>/openpages
OPENPAGES_API_ROOT=/openpages
OPENPAGES_USERNAME=<openpages-username>
OPENPAGES_PASSWORD=<openpages-password> 

# ── OpenPages MCP proxy ───────────────────────────────────────────────────────
OPENPAGES_MCP_URL=https://<mcp-proxy-host>/mcp

# ── IBM Cloud / watsonx Orchestrate ──────────────────────────────────────────
WXO_API_KEY=<watsonx-orchestrate-api-key>
WXO_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>

# ── TLS ───────────────────────────────────────────────────────────────────────
# Set to false for self-signed certificates in dev/test environments
SSL_VERIFY=true
